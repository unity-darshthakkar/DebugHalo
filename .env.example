# DebugHalo Environment Variables
# Copy this file to .env and fill in your values

# Application Configuration
DEBUGHALO_DEBUG=false
DEBUGHALO_LOG_LEVEL=info

# Processing Configuration
DEBUGHALO_MAX_FILE_SIZE=10MB
DEBUGHALO_MAX_CONCURRENT_FILES=4

# Output Configuration
DEBUGHALO_OUTPUT_FORMAT=json
DEBUGHALO_OUTPUT_DIR=./debug-output

# Note: This is a local-first tool. No API keys or external service credentials are required.
# All processing happens locally on your machine.