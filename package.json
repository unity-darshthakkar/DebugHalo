{
  "name": "debug-halo",
  "version": "1.0.0",
  "description": "Pre-deployment PII/secret detox pipeline – strip secrets before they ship",
  "descriptionShort": "Pre-deployment PII/secret detox pipeline",
  "type": "module",
  "main": "dist/core/index.js",
  "module": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser/index.js",
      "types": "./dist/browser/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/index.js",
      "types": "./dist/cli/index.d.ts"
    }
  },
  "bin": {
    "debug-halo": "dist/cli/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "build:extension": "node scripts/build-extension.mjs",
    "dev": "tsx watch src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/packed-install-smoke.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:extension": "tsc --noEmit -p tsconfig.extension.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "npm run build",
    "start": "node dist/cli/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "keywords": [
    "pii",
    "secrets",
    "secrets-detection",
    "pii-detection",
    "data-sanitization",
    "pre-commit",
    "ci-cd",
    "devsecops",
    "data-loss-prevention",
    "dlp",
    "secrets-management",
    "secrets-scanning",
    "pre-commit-hook",
    "git-hooks",
    "security",
    "privacy",
    "data-protection"
  ],
  "author": "Darsh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unity-darshthakkar/DebugHalo.git"
  },
  "bugs": {
    "url": "https://github.com/unity-darshthakkar/DebugHalo/issues"
  },
  "homepage": "https://github.com/unity-darshthakkar/DebugHalo#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fast-glob": "^3.3.2",
    "ignore": "^5.3.1"
  }
}
